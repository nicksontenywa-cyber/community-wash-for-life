/* ==========================================================================
   MINIMAL CSS - Bootstrap First Approach
   Only colors and basic resets. Bootstrap handles all layout & responsiveness.
   ========================================================================== */

:root {
    /* Core Colors */
    --primary-green: #1B4D3E;
    --dark-green: #0A2F24;
    --light-green: #2E7D5E;
    --pale-green: #EAF7F0;

    /* Accent Colors */
    --accent-teal: #0F6F6B;
    --accent-blue: #1A4B7A;
    --accent-gold: #C6A15B;
    --accent-amber: #E67E22;
    --accent-red: #B23B3B;

    /* Neutrals */
    --text-dark: #1A1E24;
    --text-light: #F9FBFD;
    --gray-100: #F8FAFC;
    --gray-200: #E9EEF2;
    --gray-300: #D0D9E0;
    --gray-400: #A0B3C2;
    --gray-500: #6C7E8C;
    --gray-600: #455A64;

    /* Gradients */
    --gradient-primary: linear-gradient(145deg, var(--primary-green) 0%, var(--dark-green) 100%);
    --gradient-light: linear-gradient(145deg, var(--light-green) 0%, var(--primary-green) 100%);
    --gradient-gold: linear-gradient(135deg, var(--accent-gold) 0%, #DAA520 50%, #B8860B 100%);

    /* Shadows */
    --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.1);
    --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.15);
    --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.2);

    /* Typography */
    --font-primary: 'Open Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-heading: 'Montserrat', 'Poppins', -apple-system, BlinkMacSystemFont, sans-serif;
}

/* ==========================================================================
   BASE RESET
   ========================================================================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    font-size: 16px;
    scroll-behavior: smooth;
}

body {
    font-family: var(--font-primary);
    color: var(--text-dark);
    background-color: #ffffff;
    line-height: 1.6;
}

h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--text-dark);
}

p {
    color: var(--gray-600);
    margin-bottom: 1rem;
}

a {
    color: var(--primary-green);
    text-decoration: none;
}

a:hover {
    color: var(--dark-green);
}

img {
    max-width: 100%;
    height: auto;
    display: block;
}

/* ==========================================================================
   BOOTSTRAP CUSTOMIZATIONS - Colors & Branding Only
   ========================================================================== */

/* Navbar Styling */
.navbar {
    background: linear-gradient(to bottom, var(--text-light), rgba(255,255,255,0.98)) !important;
    box-shadow: var(--shadow-sm);
}

.navbar.scrolled {
    box-shadow: var(--shadow-md);
}

.navbar-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--primary-green) !important;
    font-family: var(--font-heading);
}

.navbar-brand img {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    object-fit: cover;
}

.navbar-brand h1 {
    font-size: 1.3rem;
    margin: 0;
    line-height: 1.1;
    color: var(--primary-green);
}

.navbar-brand p {
    font-size: 0.75rem;
    margin: 0;
    color: var(--gray-500);
    font-family: var(--font-primary);
    font-weight: 400;
}

.nav-link {
    color: var(--primary-green) !important;
    font-weight: 600;
    position: relative;
    transition: color 0.3s ease;
}

.nav-link::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--gradient-primary);
    transition: width 0.3s ease;
}

.nav-link:hover::after,
.nav-link.active::after {
    width: 100%;
}

.nav-link:hover,
.nav-link.active {
    color: var(--dark-green) !important;
}

/* Button Styling */
.btn-primary {
    background: var(--gradient-primary);
    border: none;
    color: white;
    transition: all 0.3s ease;
}

.btn-primary:hover {
    background: var(--dark-green);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    color: white;
}

.btn-primary:active {
    transform: translateY(0);
}

/* Card Styling */
.card {
    border: 1px solid rgba(27, 77, 62, 0.1);
    box-shadow: var(--shadow-sm);
    transition: all 0.3s ease;
    overflow: hidden;
}

.card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-lg);
}

.card img {
    transition: transform 0.3s ease;
}

.card:hover img {
    transform: scale(1.05);
}

/* Form Styling */
.form-control {
    border: 2px solid var(--gray-300);
    transition: all 0.3s ease;
}

.form-control:focus {
    border-color: var(--primary-green);
    box-shadow: 0 0 0 4px rgba(27, 77, 62, 0.1);
}

.form-label {
    font-weight: 600;
    color: var(--text-dark);
}

/* Alert Styling */
.alert-success {
    background-color: rgba(27, 77, 62, 0.08);
    border-left: 4px solid var(--primary-green);
    color: var(--dark-green);
}

.alert-danger {
    background-color: rgba(178, 59, 59, 0.08);
    border-left: 4px solid var(--accent-red);
    color: var(--accent-red);
}

/* Badge Styling */
.badge {
    background: var(--pale-green);
    color: var(--primary-green);
}

.badge-primary {
    background: var(--primary-green);
    color: white;
}

/* ==========================================================================
   UTILITY CLASSES - Keep minimal
   ========================================================================== */

.section {
    padding: 3rem 0;
}

.section-title {
    text-align: center;
    margin-bottom: 2rem;
}

.section-title h2 {
    font-size: 2.5rem;
    color: var(--dark-green);
    margin-bottom: 1rem;
}

/* ==========================================================================
   ANIMATIONS - Smooth transitions
   ========================================================================== */

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes slideInDown {
    from {
        opacity: 0;
        transform: translateY(-20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.fade-in-up {
    animation: fadeInUp 0.5s ease-out;
}

/* ==========================================================================
   END OF MINIMAL BOOTSTRAP-FIRST CSS
   ========================================================================== */
