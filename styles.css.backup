/* ==========================================================================
   PREMIUM MODERN CSS – ELEVATED DESIGN SYSTEM
   Merged with functional features for New Grace JS
   ========================================================================== */

/* --------------------------------------------------------------------------
   1. CSS VARIABLES – Refined palette with depth & sophistication
   -------------------------------------------------------------------------- */
:root {
    /* Core greens – more premium, deeper */
    --primary-green: #1B4D3E;        /* Rich forest green */
    --dark-green: #0A2F24;            /* Deep pine */
    --light-green: #2E7D5E;           /* Vibrant but refined */
    --pale-green: #EAF7F0;            /* Soft mist */

    /* Accent colors – sophisticated complements */
    --accent-teal: #0F6F6B;           /* Jewel teal */
    --accent-blue: #1A4B7A;           /* Midnight blue */
    --accent-gold: #C6A15B;           /* Warm gold */
    --accent-amber: #E67E22;          /* Subtle orange */
    --accent-red: #B23B3B;            /* Deep crimson */

    /* Neutrals – for contrast and elegance */
    --text-dark: #1A1E24;             /* Almost black with blue undertone */
    --text-light: #F9FBFD;            /* Pure white with warmth */
    --gray-100: #F8FAFC;
    --gray-200: #E9EEF2;
    --gray-300: #D0D9E0;
    --gray-400: #A0B3C2;
    --gray-500: #6C7E8C;
    --gray-600: #455A64;

    /* Gradients – dynamic and luxurious */
    --gradient-primary: linear-gradient(145deg, var(--primary-green) 0%, var(--dark-green) 100%);
    --gradient-light: linear-gradient(145deg, var(--light-green) 0%, var(--primary-green) 100%);
    --gradient-gold: linear-gradient(135deg, var(--accent-gold) 0%, #DAA520 50%, #B8860B 100%);
    --gradient-silver: linear-gradient(135deg, #E0E6EF 0%, #B0C0D0 100%);
    --gradient-accent: linear-gradient(145deg, var(--accent-teal) 0%, var(--accent-blue) 100%);
    --gradient-vibrant: linear-gradient(145deg, var(--accent-amber) 0%, var(--accent-red) 50%, var(--primary-green) 100%);

    /* Shadows – layered, realistic */
    --shadow-sm: 0 8px 20px rgba(0, 20, 10, 0.06), 0 2px 6px rgba(0, 0, 0, 0.02);
    --shadow-md: 0 16px 32px -8px rgba(0, 40, 20, 0.12), 0 6px 12px -4px rgba(0, 0, 0, 0.08);
    --shadow-lg: 0 30px 60px -12px rgba(0, 60, 30, 0.2), 0 12px 24px -6px rgba(0, 0, 0, 0.12);
    --shadow-xl: 0 40px 80px -20px rgba(0, 80, 40, 0.25), 0 20px 40px -12px rgba(0, 0, 0, 0.2);
    --shadow-inner: inset 0 2px 4px rgba(0, 0, 0, 0.02);

    /* Glass effect */
    --glass-bg: rgba(255, 255, 255, 0.2);
    --glass-border: rgba(255, 255, 255, 0.3);
    --glass-shadow: 0 8px 32px rgba(0, 30, 20, 0.1);

    /* Typography */
    --font-primary: 'Open Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-heading: 'Montserrat', 'Poppins', -apple-system, BlinkMacSystemFont, sans-serif;

    /* Spacing */
    --space-unit: 8px;
    --space-xs: calc(var(--space-unit) * 1);
    --space-sm: calc(var(--space-unit) * 2);
    --space-md: calc(var(--space-unit) * 3);
    --space-lg: calc(var(--space-unit) * 4);
    --space-xl: calc(var(--space-unit) * 6);
    --space-2xl: calc(var(--space-unit) * 10);

    /* Transitions */
    --transition-fast: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-base: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-slow: 0.5s cubic-bezier(0.4, 0, 0.2, 1);

    /* Backwards-compatible aliases */
    --primary: var(--primary-green);
    --primary-dark: var(--dark-green);
    --primary-light: var(--light-green);
    --accent: var(--accent-teal);
    --light: var(--text-light);
    --dark: var(--text-dark);
    --gray: var(--gray-500);
    --shadow: var(--shadow-sm);
    --transition: all 0.3s ease;
    --secondary: var(--pale-green);
    --light-bg: #f5f5f5;
}

/* --------------------------------------------------------------------------
   2. BASE & RESET – Modern, clean foundation
   -------------------------------------------------------------------------- */
*,
*::before,
*::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    font-size: 16px;
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
}

body {
    font-family: var(--font-primary);
    color: var(--text-dark);
    line-height: 1.7;
    background-color: #ffffff;
    overflow-x: hidden;
}

/* Typography scale */
h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-dark);
    letter-spacing: -0.02em;
}

h1 { font-size: clamp(2.5rem, 5vw, 4rem); }
h2 { font-size: clamp(2rem, 4vw, 3rem); }
h3 { font-size: clamp(1.5rem, 3vw, 2rem); }
h4 { font-size: clamp(1.25rem, 2vw, 1.5rem); }

p {
    margin-bottom: 1.5rem;
    color: var(--gray-600);
}

a {
    color: var(--primary-green);
    text-decoration: none;
    transition: color var(--transition-fast);
}
a:hover {
    color: var(--dark-green);
}

img {
    max-width: 100%;
    height: auto;
    display: block;
}

/* --------------------------------------------------------------------------
   3. LAYOUT & UTILITY CLASSES
   -------------------------------------------------------------------------- */
.container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--space-lg);
}

.section {
    padding: var(--space-2xl) 0;
    position: relative;
}

.section-title {
    text-align: center;
    margin-bottom: var(--space-2xl);
    position: relative;
}

.section-title h2 {
    display: inline-block;
    position: relative;
    padding-bottom: var(--space-sm);
    margin-bottom: 0;
    font-size: 2.5rem;
    color: var(--dark-green);
}

.section-title h2::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 4px;
    background: var(--gradient-primary);
    border-radius: 4px;
    box-shadow: 0 2px 8px rgba(27, 77, 62, 0.3);
}

/* Grid helpers */
.grid-2, .grid-3, .grid-4 {
    display: grid;
    gap: var(--space-xl);
}
.grid-2 { grid-template-columns: repeat(2, 1fr); }
.grid-3 { grid-template-columns: repeat(3, 1fr); }
.grid-4 { grid-template-columns: repeat(4, 1fr); }

@media (max-width: 992px) {
    .grid-4 { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 768px) {
    .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
}

/* --------------------------------------------------------------------------
   4. NAVIGATION – Elevated with glass morphism
   -------------------------------------------------------------------------- */
header, .navbar {
    position: sticky;
    top: 0;
    z-index: 1100;
    background: rgba(255, 255, 255, 0.85);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    backdrop-filter: blur(16px) saturate(180%);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
    transition: all var(--transition-base);
    border-bottom: 1px solid rgba(27, 77, 62, 0.08);
    padding: 0.8rem 0;
}

header.hide-navbar {
    transform: translateY(-100%);
    transition: transform var(--transition-base);
}

header.show-navbar {
    transform: translateY(0);
}

.navbar .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: nowrap;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-lg);
}

.navbar-brand {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
}

.navbar-brand img {
    height: 48px;
    width: auto;
    transition: transform var(--transition-base);
    border-radius: 50%;
    box-shadow: var(--shadow-sm);
}
.navbar-brand:hover img {
    transform: scale(1.02);
}

.logo-text h1 {
    font-size: 1.6rem;
    font-weight: 800;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin: 0;
    line-height: 1.2;
}
.logo-text p {
    font-size: 0.8rem;
    margin: 0;
    color: var(--gray-500);
    letter-spacing: 0.5px;
}

.navbar-nav, nav {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
}

.nav-link {
    font-weight: 600;
    font-size: 0.95rem;
    padding: var(--space-sm) var(--space-md) !important;
    color: var(--text-dark) !important;
    position: relative;
    transition: color var(--transition-fast);
    letter-spacing: 0.3px;
    border-radius: 40px;
}
.nav-link::after {
    content: '';
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 3px;
    background: var(--gradient-primary);
    transition: width var(--transition-base);
    border-radius: 4px;
    opacity: 0.7;
}
.nav-link:hover::after,
.nav-link.active::after {
    width: calc(100% - 2rem);
}
.nav-link:hover,
.nav-link.active {
    color: var(--primary-green) !important;
    background: rgba(27, 77, 62, 0.02);
}

.navbar-toggler {
    border: 1px solid rgba(27, 77, 62, 0.2);
    padding: var(--space-xs) var(--space-sm);
    border-radius: 40px;
    background: transparent;
    transition: all var(--transition-fast);
    display: none;
}
.navbar-toggler:focus {
    box-shadow: 0 0 0 3px rgba(27, 77, 62, 0.2);
    outline: none;
}
.navbar-toggler-icon {
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba(27,77,62,0.8)' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
}

/* Mobile menu */
@media (max-width: 991.98px) {
    .navbar-collapse {
        position: fixed !important;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(255, 255, 255, 0.98);
        -webkit-backdrop-filter: blur(20px);
        backdrop-filter: blur(20px);
        z-index: 1050;
        padding: 100px var(--space-lg) var(--space-xl);
        overflow-y: auto;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        display: block !important;
    }
    .navbar-collapse.collapse:not(.show) {
        display: none !important;
    }
    .navbar-nav, nav {
        flex-direction: column;
        align-items: stretch;
        gap: var(--space-md);
    }
    .nav-link {
        font-size: 1.2rem;
        padding: var(--space-md) !important;
        border-bottom: 1px solid var(--gray-200);
    }
    .nav-link::after {
        display: none;
    }
    body.nav-open {
        overflow: hidden;
    }
}

/* --------------------------------------------------------------------------
   5. BUTTONS – Premium, with micro-interactions
   -------------------------------------------------------------------------- */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 2.2rem;
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border: 2px solid transparent;
    border-radius: 60px;
    transition: all var(--transition-base);
    cursor: pointer;
    gap: var(--space-xs);
    white-space: nowrap;
}

.btn-primary {
    background: var(--gradient-primary);
    color: white;
    box-shadow: var(--shadow-sm);
    border: none;
}
.btn-primary:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    background: linear-gradient(145deg, var(--dark-green) 0%, var(--primary-green) 100%);
    color: white;
}
.btn-primary:active {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
}

.btn-outline-primary {
    background: transparent;
    border-color: var(--primary-green);
    color: var(--primary-green);
    border: 2px solid var(--primary-green);
}
.btn-outline-primary:hover {
    background: var(--primary-green);
    color: white;
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
}

.btn-gold {
    background: var(--gradient-gold);
    color: #1a1a1a;
    border: none;
}
.btn-gold:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px rgba(198, 161, 91, 0.3);
}

.btn-large {
    padding: 1.2rem 3rem;
    font-size: 1.1rem;
}

.btn-icon {
    width: 3rem;
    height: 3rem;
    padding: 0;
    border-radius: 50%;
}

/* --------------------------------------------------------------------------
   6. CAROUSEL / HERO – Luxurious full-screen impact
   -------------------------------------------------------------------------- */
.carousel {
    position: relative;
    overflow: hidden;
}

.carousel-item {
    position: relative;
    height: 600px;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: flex-start;
}
.carousel-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(90deg, rgba(0,20,10,0.6) 0%, rgba(0,0,0,0.3) 50%, transparent 100%);
    z-index: 1;
}

.carousel-caption {
    position: relative;
    z-index: 2;
    max-width: 600px;
    width: calc(100% - 120px);
    margin-left: 60px;
    margin-right: 60px;
    background: rgba(255, 255, 255, 0.9);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    border-radius: 32px;
    padding: var(--space-xl) var(--space-2xl);
    box-shadow: var(--shadow-xl), 0 0 0 1px rgba(255,255,255,0.3) inset;
    border: 1px solid rgba(255,255,255,0.5);
    text-align: left;
    animation: floatIn 1s ease-out;
}
.carousel-caption h2 {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    color: var(--dark-green);
    margin-bottom: var(--space-sm);
    font-weight: 800;
}
.carousel-caption p {
    font-size: 1.2rem;
    color: var(--gray-600);
    margin-bottom: var(--space-lg);
}

@keyframes floatIn {
    0% { opacity: 0; transform: translateY(30px); }
    100% { opacity: 1; transform: translateY(0); }
}

.carousel-indicators button {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: rgba(255,255,255,0.6);
    border: 2px solid transparent;
    transition: all var(--transition-base);
    margin: 0 6px;
}
.carousel-indicators button.active {
    background-color: var(--primary-green);
    transform: scale(1.4);
    box-shadow: 0 0 0 4px rgba(255,255,255,0.3);
}

.carousel-control-prev,
.carousel-control-next {
    width: 4rem;
    height: 4rem;
    background: rgba(255,255,255,0.15);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-radius: 50%;
    top: 50%;
    transform: translateY(-50%);
    opacity: 0;
    transition: opacity var(--transition-base);
    border: 1px solid rgba(255,255,255,0.3);
}
.carousel:hover .carousel-control-prev,
.carousel:hover .carousel-control-next {
    opacity: 1;
}
.carousel-control-prev { left: 2rem; }
.carousel-control-next { right: 2rem; }

/* Mobile carousel adjustments */
@media (max-width: 768px) {
    .carousel-item {
        height: 500px;
        align-items: center;
        justify-content: center;
    }
    .carousel-caption {
        margin: 0 20px;
        padding: var(--space-lg) var(--space-lg);
        max-width: 100%;
        width: auto;
        text-align: center;
    }
    .carousel-control-prev,
    .carousel-control-next {
        display: none;
    }
}

/* --------------------------------------------------------------------------
   7. STATS BAR – Clean, impactful metrics
   -------------------------------------------------------------------------- */
.stats-bar {
    background: var(--gradient-primary);
    color: white;
    padding: var(--space-2xl) 0;
    position: relative;
    isolation: isolate;
}
.stats-bar::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI4MCIgaGVpZ2h0PSI4MCIgdmlld0JveD0iMCAwIDQwIDQwIj48cGF0aCBkPSJNMjAgMEwyMCA0MEwwIDIweiIgZmlsbD0icmdiYSgyNTUsMjU1LDI1NSwwLjAyKSIvPjwvc3ZnPg==');
    opacity: 0.1;
    z-index: -1;
}

.stat-item {
    text-align: center;
    position: relative;
}
.stat-item:not(:last-child)::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    height: 40%;
    width: 1px;
    background: linear-gradient(to bottom, transparent, rgba(255,255,255,0.5), transparent);
}
.stat-number {
    font-size: 3rem;
    font-weight: 800;
    font-family: var(--font-heading);
    line-height: 1.2;
    margin-bottom: var(--space-xs);
}
.stat-label {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 500;
    opacity: 0.9;
}

@media (max-width: 768px) {
    .stat-item:not(:last-child)::after { display: none; }
    .stat-number { font-size: 2.5rem; }
}

/* --------------------------------------------------------------------------
   8. CARDS – Modern, floating, with glass details
   -------------------------------------------------------------------------- */
.mission-card,
.education-card,
.feature-card,
.team-member,
.testimonial-card {
    background: white;
    border-radius: 32px;
    padding: var(--space-xl);
    transition: all var(--transition-base);
    border: 1px solid rgba(27, 77, 62, 0.1);
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
    z-index: 1;
}

.mission-card::before,
.education-card::before,
.feature-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 6px;
    background: var(--gradient-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
    z-index: 2;
}
.mission-card:hover::before,
.education-card:hover::before,
.feature-card:hover::before {
    transform: scaleX(1);
}

.mission-card:hover,
.education-card:hover,
.feature-card:hover,
.team-member:hover,
.testimonial-card:hover {
    transform: translateY(-12px);
    box-shadow: var(--shadow-lg);
    border-color: transparent;
}

.card-icon {
    font-size: 3.5rem;
    color: var(--primary-green);
    margin-bottom: var(--space-lg);
    transition: all var(--transition-base);
}
.mission-card:hover .card-icon {
    transform: scale(1.2) rotate(5deg);
    color: var(--dark-green);
}

.mission-card h3,
.education-card h3 {
    margin-bottom: var(--space-sm);
    font-size: 1.6rem;
}

/* Team member specific */
.team-member {
    text-align: center;
    padding: 0 0 var(--space-xl) 0;
}
.team-member img {
    width: 100%;
    aspect-ratio: 1/1;
    object-fit: cover;
    border-radius: 32px 32px 0 0;
    transition: transform var(--transition-base);
}
.team-member:hover img {
    transform: scale(1.02);
}
.member-info {
    padding: var(--space-lg) var(--space-lg) 0;
}
.position {
    color: var(--primary-green);
    font-weight: 600;
    margin-bottom: var(--space-xs);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-size: 0.9rem;
}
.social-links {
    display: flex;
    justify-content: center;
    gap: var(--space-xs);
    margin-top: var(--space-md);
}
.social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: var(--pale-green);
    color: var(--primary-green);
    border-radius: 50%;
    transition: all var(--transition-base);
}
.social-links a:hover {
    background: var(--primary-green);
    color: white;
    transform: translateY(-4px);
}

/* Testimonial card */
.testimonial-card {
    border-left: 6px solid var(--primary-green);
    background: linear-gradient(145deg, white, var(--pale-green));
}
.testimonial-author {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-lg);
}
.testimonial-author img {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid white;
    box-shadow: var(--shadow-sm);
}

/* --------------------------------------------------------------------------
   9. EDUCATION / GALLERY / IMPACT SECTIONS
   -------------------------------------------------------------------------- */
.education-section {
    background: linear-gradient(145deg, var(--pale-green) 0%, #ffffff 100%);
    position: relative;
    overflow: hidden;
}
.education-section::before {
    content: '';
    position: absolute;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(27,77,62,0.05) 0%, transparent 70%);
    top: -100px;
    right: -100px;
    border-radius: 50%;
}
.education-section::after {
    content: '';
    position: absolute;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(46,125,94,0.05) 0%, transparent 70%);
    bottom: -80px;
    left: -80px;
    border-radius: 50%;
}

.edu-img-container {
    height: 240px;
    overflow: hidden;
    border-radius: 24px;
    margin-bottom: var(--space-md);
}
.edu-img-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
}
.education-card:hover .edu-img-container img {
    transform: scale(1.05);
}

.edu-stats {
    display: flex;
    justify-content: space-around;
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--gray-200);
}
.stat-box .number {
    font-size: 2rem;
    font-weight: 800;
    color: var(--primary-green);
    line-height: 1;
}
.stat-box .label {
    font-size: 0.85rem;
    color: var(--gray-600);
}

/* Gallery */
.gallery-item {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-base);
}
.gallery-item:hover {
    box-shadow: var(--shadow-lg);
    transform: scale(1.02);
}
.gallery-item img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    transition: transform 0.6s ease;
}
.gallery-item:hover img {
    transform: scale(1.1);
}
.gallery-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-lg) var(--space-md);
    background: linear-gradient(to top, rgba(10,47,36,0.9), transparent);
    color: white;
    transform: translateY(100%);
    transition: transform 0.4s ease;
    font-weight: 500;
}
.gallery-item:hover .gallery-caption {
    transform: translateY(0);
}

/* --------------------------------------------------------------------------
   10. DONATION SECTION – Interactive impact
   -------------------------------------------------------------------------- */
.donate-section {
    background: var(--gradient-primary);
    color: white;
    padding: var(--space-2xl) 0;
    position: relative;
    isolation: isolate;
}
.donate-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI2MCIgaGVpZ2h0PSI2MCIgdmlld0JveD0iMCAwIDQwIDQwIj48cGF0aCBkPSJNMjAgMEwyMCA0MEwwIDIweiIgZmlsbD0icmdiYSgyNTUsMjU1LDI1NSwwLjAyKSIvPjwvc3ZnPg==');
    opacity: 0.1;
    z-index: -1;
}

.donate-amount {
    background: rgba(255,255,255,0.1);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border: 2px solid rgba(255,255,255,0.2);
    border-radius: 60px;
    padding: var(--space-md) var(--space-lg);
    cursor: pointer;
    transition: all var(--transition-base);
    text-align: center;
}
.donate-amount .amount {
    font-size: 2.2rem;
    font-weight: 800;
    line-height: 1;
    margin-bottom: var(--space-xs);
}
.donate-amount .period {
    font-size: 0.9rem;
    opacity: 0.8;
}
.donate-amount.active,
.donate-amount:hover {
    background: white;
    color: var(--primary-green);
    transform: scale(1.05);
    border-color: white;
    box-shadow: var(--shadow-lg);
}

.donation-impact {
    background: rgba(255,255,255,0.05);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-radius: 32px;
    padding: var(--space-xl);
    margin-top: var(--space-xl);
}
.impact-item {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    padding: var(--space-md);
    background: rgba(255,255,255,0.1);
    border-radius: 60px;
    margin-bottom: var(--space-sm);
    border: 1px solid rgba(255,255,255,0.1);
}
.impact-item i {
    font-size: 2.5rem;
    color: white;
}
.impact-item-text h4 {
    color: white;
    margin-bottom: 0;
    font-size: 1.2rem;
}
.impact-item-text p {
    color: rgba(255,255,255,0.7);
    margin: 0;
}

/* --------------------------------------------------------------------------
   11. FORMS & NEWSLETTER – Modern, clean
   -------------------------------------------------------------------------- */
.newsletter-section {
    background: var(--gradient-gold);
    color: #1a1a1a;
    padding: var(--space-2xl) 0;
    border-radius: 0;
    position: relative;
    overflow: hidden;
}
.newsletter-section::before {
    content: '';
    position: absolute;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, transparent 70%);
    top: -200px;
    right: -200px;
    border-radius: 50%;
}

.newsletter-container {
    max-width: 700px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
}
.newsletter-section h3 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: var(--space-sm);
    color: #1a1a1a;
}
.newsletter-form {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
    background: white;
    padding: var(--space-xs);
    border-radius: 80px;
    box-shadow: var(--shadow-lg);
}
.newsletter-form input {
    flex: 1;
    border: none;
    padding: 1.2rem 1.8rem;
    font-size: 1rem;
    border-radius: 60px;
    background: transparent;
}
.newsletter-form input:focus {
    outline: none;
    box-shadow: none;
}
.newsletter-form button {
    padding: 1rem 2.5rem;
    background: var(--gradient-primary);
    color: white;
    border: none;
    border-radius: 60px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all var(--transition-base);
}
.newsletter-form button:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
}

/* Contact form */
.contact-form {
    background: white;
    border-radius: 40px;
    padding: var(--space-xl);
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--gray-200);
}
.form-group {
    margin-bottom: var(--space-lg);
}
.form-label {
    font-weight: 600;
    color: var(--text-dark);
    margin-bottom: var(--space-xs);
    display: block;
}
.form-control {
    width: 100%;
    padding: 1rem 1.5rem;
    border: 2px solid var(--gray-200);
    border-radius: 60px;
    font-size: 1rem;
    transition: all var(--transition-fast);
    background: white;
}
.form-control:focus {
    border-color: var(--primary-green);
    box-shadow: 0 0 0 4px rgba(27, 77, 62, 0.1);
    outline: none;
}
textarea.form-control {
    border-radius: 30px;
    resize: vertical;
    min-height: 120px;
}
.form-control.is-invalid {
    border-color: var(--accent-red);
}
.form-control.is-valid {
    border-color: var(--primary-green);
}
.invalid-feedback {
    color: var(--accent-red);
    font-size: 0.85rem;
    margin-top: var(--space-xs);
}

/* --------------------------------------------------------------------------
   12. FOOTER – Professional, informative, elegant
   -------------------------------------------------------------------------- */
footer {
    background: linear-gradient(180deg, #0F1A1F 0%, #0B1418 100%);
    color: white;
    padding: var(--space-2xl) 0 0;
    margin-top: var(--space-2xl);
    position: relative;
}
.footer-top {
    border-bottom: 1px solid rgba(255,255,255,0.1);
    padding-bottom: var(--space-xl);
    margin-bottom: var(--space-xl);
}
.footer-brand img {
    height: 60px;
    width: 60px;
    border-radius: 50%;
    margin-bottom: var(--space-sm);
    box-shadow: var(--shadow-md);
}
.footer-brand h3 {
    font-size: 1.8rem;
    background: var(--gradient-gold);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: var(--space-xs);
}
.footer-brand p {
    color: var(--gray-400);
    max-width: 300px;
}
.footer-section h4 {
    color: white;
    font-size: 1.2rem;
    margin-bottom: var(--space-lg);
    position: relative;
    padding-bottom: var(--space-xs);
}
.footer-section h4::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 40px;
    height: 3px;
    background: var(--gradient-gold);
    border-radius: 4px;
}
.footer-section ul {
    list-style: none;
    padding: 0;
}
.footer-section ul li {
    margin-bottom: var(--space-sm);
}
.footer-section ul li a {
    color: var(--gray-400);
    transition: all var(--transition-fast);
    display: flex;
    align-items: center;
    gap: var(--space-xs);
}
.footer-section ul li a:hover {
    color: white;
    transform: translateX(6px);
}
.footer-contact-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
}
.footer-contact-icon {
    color: var(--accent-gold);
    font-size: 1.4rem;
    min-width: 2rem;
}
.footer-contact-info h5 {
    color: white;
    font-size: 0.95rem;
    margin-bottom: var(--space-xs);
}
.footer-contact-info p {
    color: var(--gray-400);
    margin: 0;
    font-size: 0.9rem;
}
.footer-social-icons {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
}
.footer-social-icon {
    width: 48px;
    height: 48px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    transition: all var(--transition-base);
    font-size: 1.2rem;
}
.footer-social-icon:hover {
    background: var(--gradient-gold);
    transform: translateY(-6px);
    border-color: transparent;
    box-shadow: var(--shadow-lg);
}
.footer-bottom {
    padding: var(--space-lg) 0;
    border-top: 1px solid rgba(255,255,255,0.1);
    text-align: center;
}
.footer-copyright p {
    color: var(--gray-500);
    font-size: 0.9rem;
    margin: 0;
}
.footer-copyright-links {
    display: flex;
    gap: var(--space-lg);
    justify-content: center;
    flex-wrap: wrap;
    margin-top: var(--space-sm);
}
.footer-copyright-links a {
    color: var(--gray-500);
    font-size: 0.85rem;
    transition: color var(--transition-fast);
}
.footer-copyright-links a:hover {
    color: var(--accent-gold);
}

/* --------------------------------------------------------------------------
   13. ANIMATIONS & MICRO-INTERACTIONS
   -------------------------------------------------------------------------- */
@keyframes fadeInUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
}
@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}
@keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
}

[data-aos] {
    opacity: 0;
    transition: opacity 0.6s ease, transform 0.6s ease;
}
[data-aos].aos-animate {
    opacity: 1;
}
[data-aos="fade-up"] {
    transform: translateY(30px);
}
[data-aos="fade-up"].aos-animate {
    transform: translateY(0);
}

/* Pulse effect for CTA */
.pulse {
    animation: pulse 2s infinite;
}
@keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(27, 77, 62, 0.4); }
    70% { box-shadow: 0 0 0 15px rgba(27, 77, 62, 0); }
    100% { box-shadow: 0 0 0 0 rgba(27, 77, 62, 0); }
}

/* Floating effect for cards */
.floating {
    animation: float 4s ease-in-out infinite;
}

/* Counter animation */
.counter-number {
    font-weight: 800;
    font-size: 2.5rem;
}

/* --------------------------------------------------------------------------
   14. RESPONSIVE TWEAKS – Fine-tuned for all devices
   -------------------------------------------------------------------------- */
@media (max-width: 1200px) {
    .container { max-width: 960px; }
}
@media (max-width: 992px) {
    .container { max-width: 720px; }
}
@media (max-width: 768px) {
    .container { max-width: 540px; }
    .section { padding: var(--space-xl) 0; }
    .section-title h2 { font-size: 2rem; }
}
@media (max-width: 576px) {
    .container { padding: 0 var(--space-md); }
    .btn { padding: 0.8rem 1.8rem; }
    .carousel-caption { padding: var(--space-md); }
}

/* --------------------------------------------------------------------------
   15. UTILITIES – Additional helper classes
   -------------------------------------------------------------------------- */
.text-gold { color: var(--accent-gold); }
.text-green { color: var(--primary-green); }
.bg-pale { background: var(--pale-green); }
.bg-glass {
    background: rgba(255,255,255,0.2);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.3);
}
.rounded-xl { border-radius: 32px; }
.rounded-full { border-radius: 9999px; }
.shadow-hover:hover { box-shadow: var(--shadow-lg); transform: translateY(-4px); }
.transition { transition: all var(--transition-base); }

/* Counter animation class */
.counter-animate {
    animation: fadeInUp 0.6s ease-out;
}

/* --------------------------------------------------------------------------
   16. ADVANCED PREMIUM ENHANCEMENTS – Next‑Level Interactivity
   -------------------------------------------------------------------------- */

/* Sliding Navbar – Ultra‑smooth hide/show with depth */
header {
    will-change: transform;
    -webkit-backdrop-filter: blur(20px) saturate(200%);
    backdrop-filter: blur(20px) saturate(200%);
    background: rgba(255, 255, 255, 0.7) !important;
    border-bottom: 1px solid rgba(27, 77, 62, 0.15);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                background 0.3s ease,
                box-shadow 0.3s ease;
}
header.hide-navbar {
    transform: translateY(-100%);
    box-shadow: none;
}
header.show-navbar {
    transform: translateY(0);
    box-shadow: var(--shadow-lg), 0 4px 20px rgba(27, 77, 62, 0.1);
}
.navbar.scrolled {
    background: rgba(255, 255, 255, 0.85) !important;
    border-bottom-color: rgba(27, 77, 62, 0.2);
}

/* Parallax Sections – Depth & movement */
.parallax {
    background-attachment: fixed;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    position: relative;
    isolation: isolate;
}
.parallax::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(27, 77, 62, 0.4) 0%, rgba(10, 47, 36, 0.6) 100%);
    z-index: -1;
}
.parallax-content {
    transform: translateZ(0);
    backface-visibility: hidden;
    animation: fadeInUp 1s ease-out;
}

/* Animated Counters – Gradient pulse and count effect */
.counter-number {
    display: inline-block;
    background: var(--gradient-gold);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-size: 4rem;
    font-weight: 900;
    line-height: 1;
    position: relative;
    animation: countPulse 2s infinite ease-in-out;
}
@keyframes countPulse {
    0%, 100% { text-shadow: 0 0 10px rgba(198, 161, 91, 0.2); }
    50% { text-shadow: 0 0 30px rgba(198, 161, 91, 0.6); }
}
.counter-label {
    font-size: 1.1rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gray-600);
}

/* 3D Card Hover – Tilt and shine effect */
.card-3d {
    transition: transform 0.4s cubic-bezier(0.23, 1, 0.32, 1),
                box-shadow 0.4s ease;
    transform-style: preserve-3d;
    perspective: 1000px;
    position: relative;
}
.card-3d:hover {
    transform: rotateY(2deg) rotateX(2deg) translateY(-12px);
    box-shadow: var(--shadow-xl), 0 20px 40px -10px rgba(27, 77, 62, 0.4);
}
.card-3d::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.4) 0%, transparent 50%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
    border-radius: inherit;
}
.card-3d:hover::after {
    opacity: 1;
}

/* Multi‑Item Carousel – Sleek and interactive */
.carousel-multi .carousel-inner {
    overflow: visible;
}
.carousel-multi .carousel-item {
    transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    display: grid !important;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
}
.carousel-multi .carousel-item > * {
    transition: all 0.4s ease;
}
.carousel-multi .carousel-item:not(.active) {
    opacity: 0.6;
    filter: blur(2px);
}
.carousel-multi .carousel-control-prev,
.carousel-multi .carousel-control-next {
    width: 3.5rem;
    height: 3.5rem;
    background: white;
    border-radius: 50%;
    box-shadow: var(--shadow-lg);
    color: var(--primary-green);
    top: 50%;
    transform: translateY(-50%);
    opacity: 0;
    transition: all 0.3s ease;
    border: 2px solid transparent;
}
.carousel-multi:hover .carousel-control-prev,
.carousel-multi:hover .carousel-control-next {
    opacity: 1;
}
.carousel-multi .carousel-control-prev:hover,
.carousel-multi .carousel-control-next:hover {
    background: var(--gradient-primary);
    color: white;
    transform: translateY(-50%) scale(1.1);
}
.carousel-multi .carousel-indicators {
    position: relative;
    margin-top: 2rem;
}
.carousel-multi .carousel-indicators button {
    width: 12px;
    height: 12px;
    border-radius: 12px;
    background: var(--gray-400);
    border: none;
    transition: all 0.3s ease;
}
.carousel-multi .carousel-indicators button.active {
    width: 32px;
    background: var(--gradient-primary);
    box-shadow: 0 0 12px var(--primary-green);
}

/* Scroll Reveal Animations – Smooth entry effects */
.reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1),
                transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
}
.reveal.active {
    opacity: 1;
    transform: translateY(0);
}
.reveal-left {
    opacity: 0;
    transform: translateX(-40px);
    transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
}
.reveal-left.active {
    opacity: 1;
    transform: translateX(0);
}
.reveal-right {
    opacity: 0;
    transform: translateX(40px);
    transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
}
.reveal-right.active {
    opacity: 1;
    transform: translateX(0);
}
.reveal-scale {
    opacity: 0;
    transform: scale(0.9);
    transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
}
.reveal-scale.active {
    opacity: 1;
    transform: scale(1);
}

/* Ripple Buttons – Click feedback */
.btn-ripple {
    position: relative;
    overflow: hidden;
}
.btn-ripple::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
    transform: translate(-50%, -50%);
    transition: width 0.4s ease-out, height 0.4s ease-out;
}
.btn-ripple:active::after {
    width: 200%;
    height: 200%;
    opacity: 0;
    transition: 0s;
}

/* Floating Background Shapes – Ambient motion */
.floating-shapes {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
}
.shape {
    position: absolute;
    background: rgba(27, 77, 62, 0.03);
    border-radius: 50%;
    filter: blur(40px);
    animation: floatShape 20s infinite alternate ease-in-out;
}
.shape-1 {
    width: 300px;
    height: 300px;
    top: -100px;
    left: -100px;
    background: radial-gradient(circle, rgba(46, 125, 94, 0.1) 0%, transparent 80%);
    animation-duration: 25s;
}
.shape-2 {
    width: 400px;
    height: 400px;
    bottom: -150px;
    right: -150px;
    background: radial-gradient(circle, rgba(198, 161, 91, 0.08) 0%, transparent 80%);
    animation-duration: 30s;
    animation-direction: reverse;
}
.shape-3 {
    width: 200px;
    height: 200px;
    top: 30%;
    left: 20%;
    background: radial-gradient(circle, rgba(27, 77, 62, 0.05) 0%, transparent 80%);
    animation-duration: 18s;
}
@keyframes floatShape {
    0% { transform: translate(0, 0) rotate(0deg); }
    100% { transform: translate(40px, 40px) rotate(10deg); }
}

/* Loading Skeleton / Spinner – Placeholder elegance */
.skeleton {
    background: linear-gradient(90deg, var(--gray-200) 25%, var(--gray-300) 50%, var(--gray-200) 75%);
    background-size: 200% 100%;
    animation: loading 1.5s infinite;
    border-radius: 8px;
}
@keyframes loading {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
}
.spinner {
    width: 40px;
    height: 40px;
    border: 3px solid rgba(27, 77, 62, 0.1);
    border-top-color: var(--primary-green);
    border-radius: 50%;
    animation: spin 0.8s infinite linear;
}
@keyframes spin {
    to { transform: rotate(360deg); }
}

/* Additional Micro‑Interactions */
.nav-link.active {
    text-shadow: 0 0 8px rgba(27, 77, 62, 0.3);
}

.hover-zoom {
    overflow: hidden;
    border-radius: 24px;
    position: relative;
}
.hover-zoom img {
    transition: transform 0.8s ease;
}
.hover-zoom:hover img {
    transform: scale(1.05);
}
.hover-zoom::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(27,77,62,0.3), transparent);
    opacity: 0;
    transition: opacity 0.4s ease;
}
.hover-zoom:hover::after {
    opacity: 1;
}

.hover-gradient {
    transition: all 0.3s ease;
}
.hover-gradient:hover {
    background: var(--gradient-gold);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
}

/* Advanced Responsive Touches */
@media (max-width: 768px) {
    .parallax {
        background-attachment: scroll;
    }
    .carousel-multi .carousel-item {
        grid-template-columns: 1fr;
    }
    .shape {
        filter: blur(20px);
    }

    /* ===== MOBILE RESPONSIVENESS FIX ===== */

    /* Newsletter Section - Make it smaller on mobile */
    .newsletter-section {
        padding: 2rem 1rem !important;
    }

    .newsletter-container {
        padding: 0 1rem;
        max-width: 100% !important;
    }

    .newsletter-section h3 {
        font-size: 1.5rem !important;
        margin-bottom: 0.5rem !important;
    }

    .newsletter-section p {
        font-size: 0.9rem;
        margin-bottom: 1rem;
    }

    .newsletter-form {
        flex-direction: column !important;
        gap: 0.5rem !important;
        padding: 0.5rem !important;
        border-radius: 12px !important;
        box-shadow: var(--shadow-sm) !important;
    }

    .newsletter-form input {
        padding: 0.8rem 1rem !important;
        font-size: 0.9rem;
        border-radius: 8px !important;
    }

    .newsletter-form button {
        padding: 0.8rem 1rem !important;
        font-size: 0.9rem;
        border-radius: 8px !important;
        width: 100% !important;
    }

    /* Cards - Better mobile stacking */
    .card {
        height: auto !important;
    }

    .card-img-top {
        height: 180px !important;
    }

    .card-body {
        padding: 1rem !important;
    }

    /* Reduced sections padding on mobile */
    section {
        padding: 40px 0 !important;
    }

    .section-title h2 {
        font-size: 1.8rem !important;
    }

    /* Blog cards more compact */
    .blog-card-content {
        padding: 1.2rem !important;
    }

    .blog-card-category {
        font-size: 0.75rem !important;
        padding: 0.3rem 0.8rem !important;
    }

    /* Responsive grid for cards */
    .row > [class*='col-'] {
        min-width: 0;
    }

    /* Make sure buttons are mobile friendly */
    .btn {
        font-size: 0.85rem !important;
        padding: 0.6rem 1rem !important;
    }

    .btn-lg {
        padding: 0.8rem 1.2rem !important;
        font-size: 0.95rem !important;
    }

    /* Footer bottom items stack on mobile */
    .footer-bottom-content {
        flex-direction: column !important;
        gap: 1rem !important;
    }

    .footer-bottom-item {
        text-align: center;
    }

    /* Responsive images in cards */
    .card img,
    .blog-card-img img {
        width: 100%;
        height: auto;
    }

    /* Mobile-friendly forms */
    .form-control {
        font-size: 16px !important;
        padding: 0.75rem !important;
    }

    .form-label {
        font-size: 0.9rem !important;
    }

    /* Hero sections on mobile */
    .hero {
        min-height: 40vh !important;
        padding: 60px 1rem !important;
    }

    /* Navbar brand text size on mobile */
    .navbar-brand h1 {
        font-size: 1.1rem !important;
    }

    .navbar-brand p {
        font-size: 0.7rem !important;
    }
}

/* ========================================================================
   BOOTSTRAP NAVBAR ENHANCEMENTS
   Professional styling for Bootstrap navbar component
   ======================================================================== */

.navbar {
    background: linear-gradient(to bottom, var(--text-light), rgba(255,255,255,0.98)) !important;
    box-shadow: var(--shadow-sm);
    transition: var(--transition-base);
    position: sticky !important;
    top: 0;
    z-index: 1000;
}

.navbar.scrolled {
    box-shadow: var(--shadow-md);
    background: linear-gradient(to bottom, var(--text-light), rgba(255,255,255,0.95)) !important;
}

.navbar.navbar-hide {
    transform: translateY(-100%);
}

.navbar.navbar-show {
    transform: translateY(0);
}

/* Navbar Brand - Logo Section */
.navbar-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--primary-green) !important;
    font-family: var(--font-heading);
    text-decoration: none;
    padding: 0 !important;
    margin: 0 !important;
}

.navbar-brand img {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    object-fit: cover;
}

.navbar-brand-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.navbar-brand-text h1 {
    font-size: 1.3rem;
    margin: 0;
    line-height: 1.1;
    color: var(--primary-green);
}

.navbar-brand-text p {
    font-size: 0.75rem;
    margin: 0;
    color: var(--gray-500);
    font-family: var(--font-primary);
    font-weight: 400;
}

/* Navbar Navigation Links */
.navbar-nav {
    gap: 5px;
    margin-left: auto;
}

.navbar-nav .nav-link {
    color: var(--primary-green) !important;
    font-weight: 600;
    font-size: 1rem;
    position: relative;
    padding: 8px 14px !important;
    transition: color var(--transition-base);
    text-decoration: none;
}

.navbar-nav .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 50%;
    width: 0;
    height: 2px;
    background: var(--gradient-primary);
    transition: width var(--transition-base), left var(--transition-base);
    border-radius: 2px;
}

.navbar-nav .nav-link:hover {
    color: var(--dark-green) !important;
}

.navbar-nav .nav-link:hover::after {
    width: 100%;
    left: 0;
}

.navbar-nav .nav-link.active {
    color: var(--dark-green) !important;
}

.navbar-nav .nav-link.active::after {
    width: 100%;
    left: 0;
}

/* Mobile Hamburger Toggle */
.navbar-toggler {
    border: none;
    padding: 0.5rem 0.75rem;
    font-size: 1.25rem;
    color: var(--primary-green) !important;
    transition: var(--transition-fast);
}

.navbar-toggler:focus {
    outline: 2px solid var(--primary-green);
    outline-offset: 2px;
    box-shadow: none;
}

.navbar-toggler:not(.collapsed) {
    color: var(--dark-green) !important;
}

/* Mobile Menu Collapse */
.navbar-collapse {
    transition: all var(--transition-base);
}

@media (max-width: 991px) {
    .navbar-nav {
        gap: 0;
        margin-left: 0;
        text-align: center;
        padding: 1rem 0;
    }

    .navbar-nav .nav-link {
        padding: 12px 0 !important;
        border-bottom: 1px solid rgba(27, 77, 62, 0.1);
    }

    .navbar-nav .nav-link::after {
        display: none;
    }

    .navbar-nav .nav-link.active {
        background: rgba(27, 77, 62, 0.08);
        color: var(--dark-green) !important;
    }

    .navbar-brand {
        margin-bottom: 1rem;
    }
}

/* ========================================================================
   BOOTSTRAP BUTTON ENHANCEMENTS
   Professional styling for Bootstrap button components
   ======================================================================== */

.btn {
    font-weight: 600;
    border-radius: 8px;
    transition: all var(--transition-base);
    text-transform: uppercase;
    font-size: 0.9rem;
    letter-spacing: 0.5px;
    padding: 10px 24px;
}

.btn-primary {
    background: var(--gradient-primary);
    border: none;
    color: white;
    box-shadow: var(--shadow-sm);
}

.btn-primary:hover {
    background: var(--dark-green);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    color: white;
}

.btn-primary:active {
    transform: translateY(0);
}

.btn-secondary {
    background: var(--pale-green);
    border: 2px solid var(--primary-green);
    color: var(--primary-green);
}

.btn-secondary:hover {
    background: var(--primary-green);
    color: white;
    transform: translateY(-2px);
}

.btn-lg {
    padding: 14px 32px;
    font-size: 1rem;
}

.btn-sm {
    padding: 8px 16px;
    font-size: 0.85rem;
}

/* ========================================================================
   BOOTSTRAP CARD ENHANCEMENTS
   Professional styling for Bootstrap card components
   ======================================================================== */

.card {
    border: 1px solid rgba(27, 77, 62, 0.1);
    border-radius: 16px;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-base);
    overflow: hidden;
    height: 100%;
}

.card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-lg);
    border-color: rgba(27, 77, 62, 0.2);
}

.card-img-top {
    height: 240px;
    object-fit: cover;
    transition: transform var(--transition-slow);
}

.card:hover .card-img-top {
    transform: scale(1.05);
}

.card-body {
    padding: 1.5rem;
}

.card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 1rem;
}

.card-text {
    color: var(--gray-600);
    margin-bottom: 1rem;
}

.card-footer {
    background: rgba(27, 77, 62, 0.03);
    border-top: 1px solid rgba(27, 77, 62, 0.1);
    padding: 1rem 1.5rem;
}

/* ========================================================================
   BOOTSTRAP FORM ENHANCEMENTS
   Professional form styling with validation states
   ======================================================================== */

.form-control {
    border: 2px solid var(--gray-300);
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 1rem;
    transition: all var(--transition-base);
    font-family: var(--font-primary);
}

.form-control:focus {
    border-color: var(--primary-green);
    box-shadow: 0 0 0 4px rgba(27, 77, 62, 0.1);
    outline: none;
}

.form-control::placeholder {
    color: var(--gray-400);
}

.form-label {
    font-weight: 600;
    color: var(--text-dark);
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.form-check-input {
    width: 1.25rem;
    height: 1.25rem;
    border: 2px solid var(--gray-300);
    border-radius: 4px;
    transition: all var(--transition-fast);
}

.form-check-input:focus {
    border-color: var(--primary-green);
    box-shadow: 0 0 0 4px rgba(27, 77, 62, 0.1);
}

.form-check-input:checked {
    background-color: var(--primary-green);
    border-color: var(--primary-green);
}

.form-select {
    border: 2px solid var(--gray-300);
    border-radius: 8px;
    padding: 10px 14px;
    transition: all var(--transition-base);
}

.form-select:focus {
    border-color: var(--primary-green);
    box-shadow: 0 0 0 4px rgba(27, 77, 62, 0.1);
}

.invalid-feedback {
    color: var(--accent-red);
    font-size: 0.9rem;
    display: block;
    margin-top: 0.25rem;
}

.valid-feedback {
    color: var(--primary-green);
    font-size: 0.9rem;
    display: block;
    margin-top: 0.25rem;
}

.is-invalid.form-control {
    border-color: var(--accent-red);
}

.is-valid.form-control {
    border-color: var(--primary-green);
}

/* ========================================================================
   BOOTSTRAP ALERT ENHANCEMENTS
   Professional alert styling
   ======================================================================== */

.alert {
    border: none;
    border-radius: 8px;
    border-left: 4px solid;
    padding: 1rem 1.5rem;
    animation: slideInDown 0.3s ease-out;
}

.alert-success {
    background-color: rgba(27, 77, 62, 0.08);
    border-left-color: var(--primary-green);
    color: var(--dark-green);
}

.alert-danger {
    background-color: rgba(178, 59, 59, 0.08);
    border-left-color: var(--accent-red);
    color: var(--accent-red);
}

.alert-info {
    background-color: rgba(26, 75, 122, 0.08);
    border-left-color: var(--accent-blue);
    color: var(--accent-blue);
}

.alert-warning {
    background-color: rgba(230, 126, 34, 0.08);
    border-left-color: var(--accent-amber);
    color: var(--accent-amber);
}

.alert.fade.show {
    animation: fadeInUp 0.3s ease-out;
}

/* ========================================================================
   BOOTSTRAP BADGE ENHANCEMENTS
   Professional badge styling
   ======================================================================== */

.badge {
    padding: 6px 12px;
    border-radius: 16px;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    background: var(--pale-green);
    color: var(--primary-green);
    transition: all var(--transition-fast);
}

.badge-primary {
    background: var(--primary-green);
    color: white;
}

.badge:hover {
    transform: scale(1.08);
}

/* ========================================================================
   ANIMATIONS FOR BOOTSTRAP COMPONENTS
   Smooth transitions and entrance effects
   ======================================================================== */

@keyframes slideInDown {
    from {
        transform: translateY(-20px);
        opacity: 0;
    }
    to {
        transform: translateY(0);
        opacity: 1;
    }
}

@keyframes fadeInUp {
    from {
        transform: translateY(20px);
        opacity: 0;
    }
    to {
        transform: translateY(0);
        opacity: 1;
    }
}

@keyframes floatIn {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.fade-in-up {
    animation: fadeInUp 0.5s ease-out;
}

/* ========================================================================
   MOBILE-FIRST RESPONSIVE ADJUSTMENTS FOR SMALL DEVICES
   Optimizes layout, spacing, and visibility on phones (< 480px)
   ======================================================================== */

@media (max-width: 480px) {
    /* Extreme mobile optimization */

    /* Remove excessive padding from sections */
    section {
        padding: 30px 0 !important;
    }

    /* Make container have proper breathing room */
    .container,
    .container-fluid {
        padding-left: 10px !important;
        padding-right: 10px !important;
    }

    /* Newsletter section even more compact */
    .newsletter-section {
        padding: 1.5rem 0.5rem !important;
    }

    .newsletter-container {
        padding: 0 0.5rem;
    }

    .newsletter-section h3 {
        font-size: 1.2rem !important;
        margin-bottom: 0.25rem !important;
    }

    .newsletter-section p {
        font-size: 0.8rem;
        margin-bottom: 0.75rem;
    }

    .newsletter-form {
        flex-direction: column !important;
        gap: 0.25rem !important;
    }

    .newsletter-form input,
    .newsletter-form button {
        padding: 0.6rem 0.8rem !important;
        font-size: 0.85rem;
    }

    /* Reduce card images on tiny screens */
    .card-img-top {
        height: 150px !important;
    }

    /* Tighter card spacing */
    .card {
        margin-bottom: 0.5rem;
    }

    /* Button sizing for mobile */
    .btn {
        font-size: 0.8rem !important;
        padding: 0.5rem 0.8rem !important;
    }

    .btn-lg {
        padding: 0.7rem 1rem !important;
        font-size: 0.9rem !important;
    }

    /* Hero sections smaller on phones */
    .hero {
        min-height: 35vh !important;
        padding: 50px 0.5rem !important;
    }

    h1 {
        font-size: 1.5rem !important;
    }

    h2 {
        font-size: 1.25rem !important;
    }

    h3 {
        font-size: 1.1rem !important;
    }

    /* Navbar tighter on mobile */
    .navbar {
        padding: 0.5rem 0 !important;
    }

    .navbar-brand {
        gap: 8px !important;
        font-size: 1rem !important;
    }

    .navbar-brand img {
        width: 40px !important;
        height: 40px !important;
    }

    .navbar-brand h1 {
        font-size: 1rem !important;
    }

    .navbar-brand p {
        font-size: 0.65rem !important;
    }

    /* Form elements more touch-friendly */
    .form-control {
        font-size: 16px !important;
        min-height: 44px !important;
        padding: 0.6rem !important;
    }

    input[type="text"],
    input[type="email"],
    input[type="tel"],
    textarea,
    select {
        width: 100% !important;
        font-size: 16px !important;
    }

    /* Footer content compact */
    .footer-bottom-content {
        flex-direction: column !important;
        gap: 0.75rem !important;
    }

    .footer-bottom-item h6 {
        font-size: 0.8rem !important;
        margin-bottom: 0.25rem !important;
    }

    .footer-bottom-item p {
        font-size: 0.9rem !important;
    }

    /* Gallery items single column */
    .gallery-item {
        height: auto;
    }

    /* Testimonial cards */
    .testimonial-card {
        padding: 1.5rem !important;
    }

    /* Feature cards single column on mobile */
    .feature-card,
    .feature-card-glass {
        margin-bottom: 1rem;
    }

    /* Blog cards */
    .blog-card-date {
        font-size: 0.8rem !important;
    }

    .blog-card-content {
        padding: 1rem !important;
    }

    .blog-card-category {
        font-size: 0.7rem !important;
        padding: 0.25rem 0.6rem !important;
    }

    /* Reduce margins */
    p {
        margin-bottom: 1rem !important;
    }

    /* Table scrollable on mobile */
    table {
        font-size: 0.8rem;
    }
}

/* ========================================================================
   EXTRA SMALL DEVICES (< 360px) - Very compact phones
   ======================================================================== */

@media (max-width: 360px) {
    .newsletter-section h3 {
        font-size: 1rem !important;
    }

    .newsletter-form input,
    .newsletter-form button {
        padding: 0.5rem 0.6rem !important;
        font-size: 0.8rem;
    }

    .container,
    .container-fluid {
        padding-left: 5px !important;
        padding-right: 5px !important;
    }

    h1 {
        font-size: 1.3rem !important;
    }

    h2 {
        font-size: 1.1rem !important;
    }

    .btn {
        font-size: 0.75rem !important;
        padding: 0.4rem 0.6rem !important;
    }
}

/* ==========================================================================
   END OF ADVANCED PREMIUM CSS – Next‑Level Interactivity & Animation
   ========================================================================== */
